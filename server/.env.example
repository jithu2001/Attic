# Copy to server/.env and fill in. `make up` reads this file.

# 32+ bytes. Generate with: openssl rand -hex 32
ATTIC_JWT_SECRET=

# Tailscale hostname this server answers on.
ATTIC_HOSTNAME=homeserver.tailnet.ts.net

POSTGRES_PASSWORD=attic

# Where your music actually lives on the host. Mounted read-only at /data/music.
ATTIC_MUSIC_HOST_DIR=/srv/media/music

ATTIC_LIBRARY_ROOTS=/data/originals,/data/music
ATTIC_LOG_LEVEL=info

# How often the whole library is rescanned. The filesystem watcher picks up
# changes within ATTIC_SCAN_DEBOUNCE anyway; this is the safety net.
ATTIC_SCAN_INTERVAL=1h
ATTIC_SCAN_DEBOUNCE=30s
